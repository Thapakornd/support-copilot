# Shared backend configuration. Copy to backend/.env; process variables override it.
# Connection to an existing database. Use your database host/credentials in production.
# This example connects to the optional local development database.
DATABASE_URL=postgresql://support_copilot:local_dev_password@127.0.0.1:5432/support_copilot

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:5173"]

# Leave the model/key empty until chat is configured. Health/docs still work.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# Worker only: fill with an approved model and matching registered vector schema.
# Optional database role/server override; omit to use DATABASE_URL above.
# EMBEDDING_DATABASE_URL=postgresql://runtime_user:password@127.0.0.1:5432/support_copilot
# EMBEDDING_MODEL_ID=<registered UUID>
# EMBEDDING_MODEL_NAME=<approved model identifier>
# EMBEDDING_MODEL_REVISION=<40-character upstream commit SHA>
# EMBEDDING_DIMENSIONS=<registered output dimension>
# EMBEDDING_TOKENIZER_LIMIT=<total input-token limit>
# Explicit prompts required; empty strings are allowed.
# EMBEDDING_DOCUMENT_PROMPT=""
# EMBEDDING_QUERY_PROMPT=""
# EMBEDDING_OFFLINE=true
# EMBEDDING_DEVICE=cpu
# EMBEDDING_LEASE_SECONDS=300
# EMBEDDING_HEARTBEAT_SECONDS=60
# EMBEDDING_MAX_ATTEMPTS=3
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_DOCUMENT_TOKENS=100000
# EMBEDDING_MAX_DOCUMENT_CHUNKS=2000
# EMBEDDING_TARGET_CHARS=2400
