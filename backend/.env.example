# Shared backend configuration. Copy to backend/.env; process variables override it.
# Minimum settings by command and every option are documented in README.md.

# Required for database imports and shared by the embedding commands by default.
# This URI connects to the local Compose database. Use your own URI when deploying.
DATABASE_URL=postgresql://support_copilot:local_dev_password@127.0.0.1:5432/support_copilot

# Optional API settings, prefilled for local development.
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:5173"]

# Chat uses DATABASE_URL and the same embedding configuration as the worker.
# Set the generation model and the key for the selected provider.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
# For OpenRouter, set LLM_PROVIDER=openrouter and use the full owner/model ID.
# OPENROUTER_API_KEY=

# Optional chat tuning. Calibrate the cosine cutoff with representative questions.
# CHAT_CANDIDATE_LIMIT=20
# CHAT_MAX_DISTANCE=0.5
# CHAT_MAX_PASSAGES=6
# CHAT_EVIDENCE_CHAR_LIMIT=12000
# LLM_TIMEOUT_SECONDS=30

# Optional database override for enqueue and worker commands. Defaults to DATABASE_URL.
# EMBEDDING_DATABASE_URL=postgresql://runtime_user:password@127.0.0.1:5432/support_copilot

# Required for chat, enqueue and worker commands. Match the registry and published configuration.
# EMBEDDING_MODEL_ID=<registered UUID>
# EMBEDDING_MODEL_NAME=<approved model identifier>
# EMBEDDING_MODEL_REVISION=<40-character upstream commit SHA>
# EMBEDDING_DIMENSIONS=<registered output dimension>
# EMBEDDING_TOKENIZER_LIMIT=<total input-token limit>
# Explicit prompts required; empty strings are allowed.
# EMBEDDING_DOCUMENT_PROMPT=""
# EMBEDDING_QUERY_PROMPT=""

# Optional embedding settings. Commented values show the built-in defaults.
# Set EMBEDDING_OFFLINE=false to allow the first download if the model is not cached.
# EMBEDDING_OFFLINE=true
# EMBEDDING_DEVICE=cpu
# EMBEDDING_LEASE_SECONDS=300
# EMBEDDING_HEARTBEAT_SECONDS=60
# EMBEDDING_MAX_ATTEMPTS=3
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_DOCUMENT_TOKENS=100000
# EMBEDDING_MAX_DOCUMENT_CHUNKS=2000
# EMBEDDING_TARGET_CHARS=2400

# Demo identity for the frontend endpoints (/me, /profile, /articles ...). Off by default.
# When true, the X-Demo-User header selects the user (impersonation by design), so it is
# rejected unless API_HOST is 127.0.0.1, localhost or ::1. Seed people: sql/demo_identities.sql.
# DEMO_AUTH=false
